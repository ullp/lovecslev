# Zkopíruj na .env a uprav dle potřeby. Hodnoty odpovídají docker-compose.yml (spec §8.3).
NODE_ENV=development
PORT=3000

# PostgreSQL 16
DATABASE_URL=postgresql://lovecslev:lovecslev@localhost:5432/lovecslev?schema=public

# Redis 7 (cache, rate-limit, fronta)
REDIS_URL=redis://localhost:6379

# Elasticsearch 8 (SearchPort: ElasticSearchAdapter)
ELASTICSEARCH_URL=http://localhost:9200
SEARCH_DRIVER=elasticsearch

# Feature flags (spec §12.3, D18)
FEATURE_AI_MATCHING=false
FREE_VARIANT_B=false

# Auth (spec §15.3) — v produkci POVINNÉ, min. 16 znaků
JWT_ACCESS_SECRET=dev-only-access-secret-change-me

# AI poradce (P1) — bez klíče se použije deterministická šablona
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Transakční e-maily (D20) — bez klíče se e-mail jen zaloguje
RESEND_API_KEY=
RESEND_FROM=Lovec Slev <no-reply@lovecslev.cz>

# Scraping (spec §14.5) — právní gate, default vypnuto
SCRAPING_ENABLED=false
# http = reálné stahování (vyžaduje SCRAPE_LIDL_URL + legal_approved), fixture = offline snapshoty
SCRAPE_SOURCE=fixture
SCRAPE_LIDL_URL=
SCRAPE_FIXTURE_DIR=test/fixtures/scrape
SNAPSHOT_DIR=storage/raw
